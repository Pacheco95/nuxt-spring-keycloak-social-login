{
  "name": "frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "format": "bunx prettier . --write",
    "format:check": "bunx prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "@nuxt/eslint": "1.15.2",
    "eslint": "^9.0.0 || ^10.0.0",
    "nuxt": "^4.4.4",
    "nuxt-oidc-auth": "^1.0.0-beta.11",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "3.8.3",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "**/*": [
      "prettier --write --ignore-unknown",
      "eslint --fix"
    ]
  }
}
