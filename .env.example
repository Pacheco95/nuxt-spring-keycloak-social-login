# ─────────────────────────────────────────────────────────────────────────────
# Project-wide configuration. Single source of truth for every docker-compose
# service. Copy this file to `.env` and fill in the blank secret values.
#
# Naming convention: <SERVICE_PREFIX>_<NAME>, SCREAMING_SNAKE_CASE.
# Service prefixes: KEYCLOAK_*, KEYCLOAK_DB_*, KEYCLOAK_REALM_*,
#                   BACKEND_*, BACKEND_DB_*, FRONTEND_*, PGADMIN_*, GOOGLE_*.
# Inside docker-compose.yml these are remapped to whatever variable each
# image expects (e.g. KEYCLOAK_DB_NAME → POSTGRES_DB).
# ─────────────────────────────────────────────────────────────────────────────

COMPOSE_PROJECT_NAME=social-login

# ─── Keycloak ────────────────────────────────────────────────────────────────
# KEYCLOAK_HOSTNAME is the browser-visible URL. It MUST match the issuer
# Spring Boot expects, so do not change it without also updating
# BACKEND_OIDC_ISSUER_URI below and KEYCLOAK_HTTP_HOST_PORT (which controls
# the host-side port the URL points at). See CLAUDE.md / social-login-impl.md
# for the rationale (issuer-mismatch is the most common failure mode here).
KEYCLOAK_HTTP_PORT=8080         # port Keycloak listens on inside the container
KEYCLOAK_HTTP_HOST_PORT=8080    # host port mapped to the container's port
KEYCLOAK_HOSTNAME=http://localhost:8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# ─── Keycloak's database ─────────────────────────────────────────────────────
KEYCLOAK_DB_HOST=keycloak-db
KEYCLOAK_DB_PORT=5432
KEYCLOAK_DB_HOST_PORT=5433
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=

# ─── Keycloak realm bootstrap ────────────────────────────────────────────────
# Consumed by the realm-init container's bootstrap-realm.sh.
KEYCLOAK_REALM_NAME=social-login
KEYCLOAK_REALM_CLIENT_ID=nuxt-bff
KEYCLOAK_REALM_CLIENT_SECRET=

# ─── Backend (Spring Boot) ───────────────────────────────────────────────────
BACKEND_HTTP_PORT=8081
BACKEND_HTTP_HOST_PORT=8081
BACKEND_LOG_LEVEL=INFO
# Issuer must match what Keycloak puts in the JWT 'iss' claim (browser-facing
# URL of Keycloak). The JWK set URI is fetched by Spring server-side from
# inside the docker network — that one is assembled in docker-compose.yml
# from the keycloak service name + KEYCLOAK_HTTP_PORT, not stored here.
BACKEND_OIDC_ISSUER_URI=http://localhost:8080/realms/social-login

# ─── Backend's database ──────────────────────────────────────────────────────
BACKEND_DB_HOST=backend-db
BACKEND_DB_PORT=5432
BACKEND_DB_HOST_PORT=5434
BACKEND_DB_NAME=backend
BACKEND_DB_USER=backend
BACKEND_DB_PASSWORD=

# ─── Frontend (Nuxt BFF) ─────────────────────────────────────────────────────
FRONTEND_HTTP_PORT=3000
FRONTEND_HTTP_HOST_PORT=3000
# >=48 character random string used by nuxt-oidc-auth to seal session cookies
# AND to encrypt access/id tokens in the persistent session storage.
# Generate with: openssl rand -base64 36
FRONTEND_SESSION_PASSWORD=
# Browser-visible URLs (used in OAuth redirects). The internal URL the Nuxt
# server uses to call Keycloak / the backend is assembled in
# docker-compose.yml from the service names + their *_HTTP_PORT vars.
FRONTEND_PUBLIC_URL=http://localhost:3000
FRONTEND_OIDC_KEYCLOAK_PUBLIC_URL=http://localhost:8080
FRONTEND_OIDC_REDIRECT_URI=http://localhost:3000/auth/keycloak/callback
FRONTEND_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/

# ─── PgAdmin ─────────────────────────────────────────────────────────────────
# PGADMIN_HTTP_PORT is the in-container listening port (set via
# PGADMIN_LISTEN_PORT on the image). PGADMIN_HTTP_HOST_PORT is what's
# published on the host.
PGADMIN_HTTP_PORT=80
PGADMIN_HTTP_HOST_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=

# ─── Google OAuth (used by Keycloak's Google IdP) ────────────────────────────
# Create these in the Google Cloud Console — see README.md for the walkthrough.
# The Authorized Redirect URI you must register in Google is:
#   http://localhost:8080/realms/social-login/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
