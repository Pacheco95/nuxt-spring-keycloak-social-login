# Local environment — only the example is committed.
.env
.env.*
!.env.example

# IDE / OS
.idea/
.vscode/
.DS_Store

# Build output (per-module .gitignore covers the rest)
**/build/
**/.gradle/
**/node_modules/
**/.nuxt/
**/.output/

# Playwright (e2e/) runtime artifacts
e2e/playwright-report/
e2e/test-results/

# Docker volumes (if any are bind-mounted under the repo)
infra/.volumes/
