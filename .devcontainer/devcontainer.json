{
  "name": "social-login",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  // Mount the project at the same path inside the container as on the host so
  // that bind paths in infra/docker-compose.yml resolve correctly when `make up-*`
  // is invoked from inside the devcontainer (docker-outside-of-docker hits the
  // host daemon, which only knows host paths). The host path is propagated to
  // the compose file via .devcontainer/.env written by initializeCommand.
  "workspaceFolder": "${localWorkspaceFolder}",
  "initializeCommand": "echo \"LOCAL_WORKSPACE_FOLDER=${localWorkspaceFolder}\" > .devcontainer/.env",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "24-tem",
      "installGradle": false
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/shyim/devcontainers-features/bun:0": {}
  },
  "postCreateCommand": "cd frontend && bun install || true",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "fwcd.kotlin",
        "Vue.volar",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "EditorConfig.EditorConfig",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "java.jdt.ls.java.home": "/usr/local/sdkman/candidates/java/current",
        "java.configuration.runtimes": [
          { "name": "JavaSE-24", "path": "/usr/local/sdkman/candidates/java/current", "default": true }
        ],
        "files.eol": "\n"
      }
    }
  }
}
